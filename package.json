{
  "name": "@kyoukisu/dsh-rich-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/host/index.js",
  "exports": {".": "./lib/host/index.js", "./client": "./lib/host/client.js"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"inject": [], "platform": "web"}},
  "description": "Reference-driven rich responses for DeepSeek Harness",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:plugin": "vite build --config vite.plugin.config.ts --mode host-node && vite build --config vite.plugin.config.ts",
    "test": "vitest run tests/core src/host",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  }
}
