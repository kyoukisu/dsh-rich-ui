{
  "name": "@kyoukisu/dsh-rich-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/host/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "description": "Reference-driven rich responses for DeepSeek Harness",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:plugin": "vite build --config vite.plugin.config.ts --mode host-node && vite build --config vite.plugin.config.ts",
    "test": "vitest run tests/core tests/ui src/host",
    "test:e2e": "playwright test --update-snapshots=none",
    "test:browser": "bash scripts/browser-check.sh --update-snapshots=none",
    "dev:plugin": "vite build --config vite.plugin.config.ts --watch",
    "format": "prettier --write src tests scripts *.ts *.json *.html",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html",
    "check": "npm run build && npm run build:plugin && npm test && npm run test:browser"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  }
}
